# ─────────────────────────────────────────────────────────────────────────────
# 컴학내전 환경변수. 로컬에서는 이 파일을 .env.local 로 복사해 채우고,
# Vercel 에서는 Project → Settings → Environment Variables 에 같은 이름으로 넣습니다.
# 실제 값은 절대 커밋하지 마세요 (.env* 는 .gitignore 에 들어 있습니다).
# ─────────────────────────────────────────────────────────────────────────────

# [공개] Supabase 프로젝트 주소 — Supabase → Project Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# [공개] 읽기 전용 키 — 같은 화면의 "anon public" 키.
# 브라우저에 노출되지만 01_schema.sql 의 RLS 때문에 조회만 가능합니다.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# [비밀] 쓰기 키 — 같은 화면의 "service_role" 키. 서버에서만 사용합니다.
# 이름 앞에 NEXT_PUBLIC_ 을 붙이면 안 됩니다. Vercel 에서 "Sensitive" 로 저장하세요.
SUPABASE_SERVICE_ROLE_KEY=

# [비밀] 관리자 비밀번호 — 웹에서 경기 등록·수정·삭제, 선수 정보 수정, 백업·가져오기에 필요. 8자 이상.
ADMIN_PASSWORD=

# [비밀] 수집기 업로드 토큰 — 수집기를 쓰는 사람에게만 알려 줍니다. 8자 이상, ADMIN_PASSWORD 와 다르게.
# 이 토큰으로는 경기 "추가"만 가능하고 수정·삭제는 할 수 없습니다.
# 예: openssl rand -hex 24  로 만든 값
UPLOAD_SECRET=
